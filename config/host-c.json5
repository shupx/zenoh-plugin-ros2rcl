{
  mode: "peer",
  // B connects here. A and C have no direct connection or ROS routes.
  listen: {
    endpoints: ["tcp/0.0.0.0:7448"],
  },
  scouting: {
    multicast: {
      enabled: false,
    },
    gossip: {
      enabled: false,
    },
  },
  plugins: {
    ros2rcl: {
      publish: [
        {
          ros_topic: "/chatter",
          zenoh_key_prefix: "host_c",
          ros_type: "std_msgs/msg/String",
        },
      ],
      subscribe: [
        {
          zenoh_key: "host_b/chatter",
          ros_topic: "/from_b/chatter",
          ros_type: "std_msgs/msg/String",
        },
      ],
      expose_services: [
        {
          ros_service: "/add_two_ints",
          zenoh_key_prefix: "host_c",
          ros_type: "example_interfaces/srv/AddTwoInts",
          timeout_ms: 5000,
        },
      ],
      query_services: [
        {
          zenoh_key: "host_b/add_two_ints",
          ros_service: "/from_b/add_two_ints",
          ros_type: "example_interfaces/srv/AddTwoInts",
          timeout_ms: 6000,
        },
      ],
    },
  },
}
